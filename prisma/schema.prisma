// B'Seder — Prisma Schema v2
// ORM: Prisma 5  |  DB: MySQL (Railway)
// utf8mb4 throughout for Hebrew character support
//
// Core principle:
//   Goals are RULES.  Assignments are OCCURRENCES.
//   Completion state lives on assignments, never on goals.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────
model User {
  id                 String    @id @default(uuid()) @db.Char(36)
  email              String    @unique @db.VarChar(320)
  displayName        String?   @db.VarChar(100)
  passwordHash       String?   @db.VarChar(255)
  avatarUrl          String?   @db.VarChar(500)
  subscriptionStatus String    @default("free") @db.VarChar(20)
  isAdmin            Boolean   @default(false)
  onboardingComplete Boolean   @default(false)
  referralSource     String?   @db.VarChar(100)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  accounts    Account[]
  sessions    Session[]
  preferences UserPreferences?
  adminEvents AdminEvent[]
  goals       Goal[]
  assignments Assignment[]

  @@index([deletedAt])
  @@map("users")
}

// ─── NextAuth: OAuth Accounts ─────────────────────────────────────────────────
model Account {
  id                String  @id @default(uuid()) @db.Char(36)
  userId            String  @db.Char(36)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// ─── NextAuth: Sessions ───────────────────────────────────────────────────────
model Session {
  id           String   @id @default(uuid()) @db.Char(36)
  sessionToken String   @unique
  userId       String   @db.Char(36)
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─── NextAuth: Verification Tokens ───────────────────────────────────────────
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── User Preferences ─────────────────────────────────────────────────────────
model UserPreferences {
  userId                      String   @id @db.Char(36)
  locationKey                 String   @default("los-angeles-ca") @db.VarChar(64)
  timeFormat                  String   @default("12h") @db.VarChar(3)
  showHebrewDates             Boolean  @default(true)
  weekStartsOn                Int      @default(0)
  defaultView                 String   @default("week") @db.VarChar(10)
  showParsha                  Boolean  @default(true)
  showRoshChodesh             Boolean  @default(true)
  showOmer                    Boolean  @default(true)
  showModernHolidays          Boolean  @default(false)
  showOutsideMonthDays        Boolean  @default(true)
  havdalahOpinion             String   @default("tzeit-8_5") @db.VarChar(20)
  havdalahMode                String   @default("nusach") @db.VarChar(20)
  nusach                      String   @default("ashkenaz") @db.VarChar(20)
  observanceLevel             String   @default("unknown") @db.VarChar(20)
  timelineSnapMins            Int      @default(15)
  timelineDefaultDurationMins Int      @default(30)
  showHebrewDatesOnGoals      Boolean  @default(false)
  hebrewDateFormat            String   @default("english") @db.VarChar(10)
  hebrewDateIncludeYear       Boolean  @default(false)
  hebrewMode                  Boolean  @default(false)  // ★ Hebrew/Gregorian week toggle
  updatedAt                   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ─── Goal Presets ★ NEW ───────────────────────────────────────────────────────
// Catalog of curated goals: Tefillin, Daf Yomi, Havdalah, Shacharis, etc.
// When a user adds a preset, a Goal row is created with source="preset"
// and presetId pointing here. Editing it flips source to "preset_modified".
model GoalPreset {
  id          String  @id @default(uuid()) @db.Char(36)
  slug        String  @unique @db.VarChar(80)
  title       String  @db.VarChar(200)
  description String? @db.Text
  emoji       String? @db.VarChar(8)

  cadence           String  @db.VarChar(20)
  measure           String  @db.VarChar(10)
  failureMode       String  @db.VarChar(20)
  dayModel          String? @db.VarChar(10)
  startsAtDefault   String? @db.VarChar(100)
  expiresAtDefault  String? @db.VarChar(100)
  targetDefault     Int?
  targetUnitDefault String? @db.VarChar(100)
  exclusionsDefault Json?   // string[] of holiday keys
  activeDaysDefault Json?   // int[] of day-of-week (0=Sun..6=Sat)
  seasonalRule      Json?   // e.g. { start: "16 Nisan", endRule: "+49 days" }

  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goals Goal[]

  @@index([isPublished, sortOrder])
  @@map("goal_presets")
}

// ─── Hebcal Day Cache ★ NEW ───────────────────────────────────────────────────
// Caches @hebcal/core output per (locationKey, gregorianDate).
// Multiple users in the same city share one row per day.
model HebcalDayCache {
  id            String   @id @default(uuid()) @db.Char(36)
  locationKey   String   @db.VarChar(64)
  gregorianDate DateTime @db.Date

  // Denormalized for fast queries without unpacking JSON
  hebrewYear    Int
  hebrewMonth   Int      // 1..13 (Adar II = 13)
  hebrewDay     Int      // 1..30
  hebrewDateStr String   @db.VarChar(40)
  isShabbat     Boolean  @default(false)
  isYomTov      Boolean  @default(false)
  isCholHamoed  Boolean  @default(false)
  isRoshChodesh Boolean  @default(false)
  isFastDay     Boolean  @default(false)
  parsha        String?  @db.VarChar(80)
  omerDay       Int?     // 1..49 during Omer; null otherwise

  // Full @hebcal/core payload: zmanim{}, events[], candles{}, havdalah{}, etc.
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@unique([locationKey, gregorianDate])
  @@index([gregorianDate])
  @@index([expiresAt])
  @@map("hebcal_day_cache")
}

// ─── Goals ────────────────────────────────────────────────────────────────────
// A goal is a RULE. It never stores completion state.
// Completions, partial progress, and scheduling live in Assignment rows.
model Goal {
  id           String    @id @default(uuid()) @db.Char(36)
  userId       String    @db.Char(36)
  parentGoalId String?   @db.Char(36)

  title       String  @db.VarChar(500)
  description String? @db.Text
  emoji       String? @db.VarChar(8)

  // cadence: "daily"|"weekly"|"monthly"|"yearly"|"seasonal"|"project"|"one-time"
  cadence String @db.VarChar(20)

  // measure: "binary" = done/not-done | "numeric" = X units per period
  measure String @db.VarChar(10)

  // status: "ongoing"|"paused"|"done"|"archived"|"killed"
  status String @default("ongoing") @db.VarChar(20)

  // ── Source / color coding ★ NEW ───────────────────────────────────────────
  // "preset"          → BLUE chip
  // "preset_modified" → YELLOW chip
  // "custom"          → no chip
  // "one_off"         → light grey chip
  source   String  @default("custom") @db.VarChar(20)
  presetId String? @db.Char(36)

  // dayModel: "civil" (midnight) | "jewish" (nightfall)
  dayModel String? @db.VarChar(10)

  // Numeric config
  target      Int?
  targetUnit  String? @db.VarChar(100)
  totalTarget Int?    // PROJECT goals only: total units to complete

  // Failure semantics
  // failureMode: "punishing"|"forgiving"|"kill_streak"
  failureMode String @default("forgiving") @db.VarChar(20)
  // carryover: "drop"|"rollover"|"backlog"
  carryover   String @default("drop") @db.VarChar(20)

  noGettingAhead Boolean @default(false)

  // Time window (zmanim keys from @hebcal/core, e.g. "misheyakir", "chatzot")
  // These are RULE defaults. Resolved timestamps are snapshotted onto each Assignment.
  startsAt  String? @db.VarChar(100)
  expiresAt String? @db.VarChar(100)

  preferredMonthDay String? @db.VarChar(10) // "first"|"last"|"1".."31"
  lockInDays        Boolean @default(false)

  startDate       DateTime? @db.Date
  endDate         DateTime? @db.Date
  dueDate         DateTime? @db.Date
  endAfterPeriods Int?

  // programKey: links goal to external schedule for per-date labels
  // "daf-yomi" = show "Menachot 108" etc. via @hebcal/learning
  programKey String? @db.VarChar(50)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  pausedAt    DateTime?
  archivedAt  DateTime?
  deletedAt   DateTime?

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Goal?               @relation("GoalParent", fields: [parentGoalId], references: [id], onDelete: SetNull)
  children      Goal[]              @relation("GoalParent")
  preset        GoalPreset?         @relation(fields: [presetId], references: [id], onDelete: SetNull)
  activeDays    GoalActiveDay[]
  exclusions    GoalExclusion[]
  milestones    GoalMilestone[]
  periods       GoalPeriod[]
  statusHistory GoalStatusHistory[]
  assignments   Assignment[]
  asProject     ProjectFeeder[]     @relation("ProjectGoal")
  asFeeder      ProjectFeeder[]     @relation("FeederGoal")

  @@index([userId, cadence, deletedAt])
  @@index([userId, status])
  @@index([presetId])
  @@map("goals")
}

// ─── Goal Active Days ──────────────────────────────────────────────────────────
model GoalActiveDay {
  goalId    String @db.Char(36)
  dayOfWeek Int    // 0=Sun..6=Sat

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([goalId, dayOfWeek])
  @@map("goal_active_days")
}

// ─── Goal Exclusions ──────────────────────────────────────────────────────────
// Jewish holidays on which the goal does not apply.
// App expands category picks ("Yom Tov") into individual keys before writing.
model GoalExclusion {
  goalId     String @db.Char(36)
  holidayKey String @db.VarChar(100)

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([goalId, holidayKey])
  @@map("goal_exclusions")
}

// ─── Goal Milestones ──────────────────────────────────────────────────────────
model GoalMilestone {
  id           String    @id @default(uuid()) @db.Char(36)
  goalId       String    @db.Char(36)
  label        String    @db.VarChar(500)
  markerAmount Int?
  sortOrder    Int       @default(0)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_milestones")
}

// ─── Goal Periods ─────────────────────────────────────────────────────────────
// One row per goal per period. Materializes aggregates so calendar renders
// never re-scan the full assignments table from scratch.
//
// period_key format:
//   daily   → "2026-04-29"
//   weekly  → "2026-04-26"  (Sunday of that week)
//   monthly → "2026-04"
//   yearly  → "2026"
model GoalPeriod {
  id              String    @id @default(uuid()) @db.Char(36)
  goalId          String    @db.Char(36)
  periodKey       String    @db.VarChar(20)
  targetAmount    Int
  plannedAmount   Int       @default(0)
  completedAmount Int       @default(0)
  backlogIn       Int       @default(0)
  backlogOut      Int       @default(0)
  periodEndedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, periodKey])
  @@map("goal_periods")
}

// ─── Goal Status History ──────────────────────────────────────────────────────
// Append-only. Never update or delete rows.
model GoalStatusHistory {
  id         String   @id @default(uuid()) @db.Char(36)
  goalId     String   @db.Char(36)
  fromStatus String?  @db.VarChar(20)
  toStatus   String   @db.VarChar(20)
  changedAt  DateTime @default(now())
  note       String?  @db.Text

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_status_history")
}

// ─── Assignments ──────────────────────────────────────────────────────────────
// A single occurrence of a goal on a specific day.
//
// HYBRID MATERIALIZATION RULE:
//   A row only exists when something happened: user completed, partially
//   progressed, scheduled, rescheduled, or skipped the occurrence.
//   "Pending" occurrences are computed virtually by getDayInstances().
//   Use Prisma upsert on all writes — the @@unique([goalId, date]) constraint
//   ensures there is never more than one row per (goal, day).
model Assignment {
  id     String @id @default(uuid()) @db.Char(36)
  goalId String @db.Char(36)
  userId String @db.Char(36)

  // date           = Gregorian planner column
  // occurrenceDate = halachic obligation date (null → same as date)
  date           DateTime  @db.Date
  occurrenceDate DateTime? @db.Date

  // ★ Hebrew date, snapshotted at write time from HebcalDayCache.
  // Powers Hebrew/Gregorian toggle without re-querying cache.
  hebrewYear  Int?
  hebrewMonth Int?
  hebrewDay   Int?

  // ★ Seasonal ordinal (e.g. omerDay=27). Null for non-seasonal goals.
  seasonalIndex Int?

  periodKey String? @db.VarChar(20)

  // Time window snapshotted at materialization from goal.startsAt/expiresAt
  // resolved against that day's zmanim. Prevents historical tasks shifting.
  windowStart DateTime?
  windowEnd   DateTime?

  targetAmount  Int?
  scheduledTime String? @db.VarChar(5)
  durationMins  Int?

  completed    Boolean   @default(false)
  completedAt  DateTime?
  actualAmount Int?

  // status: "planned"|"completed"|"in_progress"|"missed"|"expired_forgiven"|"skipped"
  status String @default("planned") @db.VarChar(20)

  // materializedReason: "user_completed"|"user_partial"|"user_scheduled"
  //   "user_rescheduled"|"system_expired"|"system_rollover"
  materializedReason String? @db.VarChar(30)

  originalDate DateTime? @db.Date
  note         String?   @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, date])
  @@index([userId, date])
  @@index([userId, hebrewYear, hebrewMonth, hebrewDay])
  @@index([goalId, status])
  @@index([deletedAt])
  @@map("assignments")
}

// ─── Goal Suppression ★ NEW ───────────────────────────────────────────────────
// Replaces v1's `skipped` + `replacedAutoDate` fields on Assignment.
// One row per (goal, date) where virtual auto-show should NOT render.
model GoalSuppression {
  id     String   @id @default(uuid()) @db.Char(36)
  goalId String   @db.Char(36)
  userId String   @db.Char(36)
  date   DateTime @db.Date

  // "moved"|"skipped"|"deleted_assignment"|"user_paused_day"
  reason String @db.VarChar(30)

  // If suppression was created because assignment moved elsewhere,
  // points to destination assignment for cleanup on re-move/delete.
  relatedAssignmentId String? @db.Char(36)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([goalId, date, deletedAt])
  @@index([userId, date])
  @@map("goal_suppression")
}

// ─── Project Feeders ★ NEW ────────────────────────────────────────────────────
model ProjectFeeder {
  id            String  @id @default(uuid()) @db.Char(36)
  projectGoalId String  @db.Char(36)
  feederGoalId  String  @db.Char(36)
  weight        Decimal @default(1.0000) @db.Decimal(10, 4)
  autoRollup    Boolean @default(true)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  projectGoal Goal @relation("ProjectGoal", fields: [projectGoalId], references: [id], onDelete: Cascade)
  feederGoal  Goal @relation("FeederGoal",  fields: [feederGoalId],  references: [id], onDelete: Cascade)

  @@unique([projectGoalId, feederGoalId])
  @@index([feederGoalId])
  @@map("project_feeders")
}

// ─── Project Progress ★ NEW ───────────────────────────────────────────────────
// Append-only ledger. Total project progress = SUM(amount).
model ProjectProgress {
  id                 String   @id @default(uuid()) @db.Char(36)
  userId             String   @db.Char(36)
  projectGoalId      String   @db.Char(36)
  amount             Decimal  @db.Decimal(12, 2)
  occurredOn         DateTime @db.Date
  // "feeder_auto"|"manual_entry"|"backfill"|"correction"
  source             String   @db.VarChar(20)
  sourceAssignmentId String?  @db.Char(36)
  note               String?  @db.Text

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([projectGoalId, occurredOn])
  @@index([userId, projectGoalId])
  @@map("project_progress")
}

// ─── User Goal Order ──────────────────────────────────────────────────────────
model UserGoalOrder {
  userId    String @db.Char(36)
  goalId    String @db.Char(36)
  sortOrder Int    @default(0)

  @@id([userId, goalId])
  @@index([userId, sortOrder])
  @@map("user_goal_order")
}

// ─── Admin Event Log ──────────────────────────────────────────────────────────
model AdminEvent {
  id        String   @id @default(uuid()) @db.Char(36)
  type      String   @db.VarChar(50)
  userEmail String?  @db.VarChar(320)
  details   String?  @db.Text
  createdAt DateTime @default(now())
  userId    String?  @db.Char(36)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type])
  @@map("admin_events")
}
