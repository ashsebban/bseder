# Required at runtime for accounts and planner data (MySQL).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Set this to the public HTTPS origin in production.
AUTH_URL="http://localhost:3000"
# Set to true only when running behind a trusted reverse proxy.
AUTH_TRUST_HOST=""

# Google sign-in (optional for email/password sign-in).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Password reset email (only required when sending mail).
RESEND_API_KEY=""
RESEND_FROM="B'Seder <noreply@beseder.app>"

# Optional integrations.
MAPBOX_ACCESS_TOKEN=""
DBVIS_PASSCODE=""
